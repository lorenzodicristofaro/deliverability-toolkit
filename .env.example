# Copy to .env (gitignored) and fill in. Never commit real values.

# Required. Empty or whitespace-only counts as missing and the app refuses to start.
SECRET_KEY=
ENCRYPTION_KEY=

# Default: sqlite:////data/app.db
#DATABASE_URL=sqlite:////data/app.db
# With `docker compose --profile postgres up` the app does NOT use PostgreSQL unless you set this
# (service name `postgres`, user and database are the compose defaults). <password> must be
# the POSTGRES_PASSWORD below, percent-encoded if it has special characters (@ : / % ? #).
# The app may retry for a few seconds while PostgreSQL starts (restart: unless-stopped).
#DATABASE_URL=postgresql://deliverability:<password>@postgres:5432/deliverability

# system | custom | unbound (default system). custom and unbound require RESOLVER_ADDRS.
#RESOLVER_MODE=system
# Comma-separated host:port, IP literals only, IPv6 as [::1]:5353, default port 53.
#RESOLVER_ADDRS=
# With `docker compose --profile unbound up` use:
#RESOLVER_MODE=unbound
#RESOLVER_ADDRS=172.28.53.2:5353

# web | worker | all (default all)
#ROLE=all

# true | false (default false)
#ALLOW_SMTP_CHECKS=false
#ALLOW_REGISTRATION=false

# Public URL of this instance (http:// or https://).
#BASE_URL=http://localhost:8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL (default INFO)
#LOG_LEVEL=INFO

# Login sessions, in minutes: idle timeout (since the last request) and absolute lifetime.
# Both must be > 0 and idle <= absolute, otherwise the app refuses to start.
#SESSION_IDLE_TIMEOUT_MINUTES=30
#SESSION_ABSOLUTE_TIMEOUT_MINUTES=720

# Only needed with `docker compose --profile postgres up`. Choose your own value.
POSTGRES_PASSWORD=
