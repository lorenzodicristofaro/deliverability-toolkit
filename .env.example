# Copy to .env (gitignored) and fill in. Never commit real values.

# Required. Empty or whitespace-only counts as missing and the app refuses to start.
SECRET_KEY=
# ENCRYPTION_KEY must be a Fernet key (docs/SETUP.md section 10), generate one with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Default: sqlite:////data/app.db
#DATABASE_URL=sqlite:////data/app.db
# With `docker compose --profile postgres up` the app does NOT use PostgreSQL unless you set this
# (service name `postgres`, user and database are the compose defaults). <password> must be
# the POSTGRES_PASSWORD below, percent-encoded if it has special characters (@ : / % ? #).
# At start the app waits up to 60 s for PostgreSQL to accept connections (docs/SETUP.md §8).
#DATABASE_URL=postgresql://deliverability:<password>@postgres:5432/deliverability

# system | custom | unbound (default system). custom and unbound require RESOLVER_ADDRS.
#RESOLVER_MODE=system
# Comma-separated host:port, IP literals only, IPv6 as [::1]:5353, default port 53.
#RESOLVER_ADDRS=
# With `docker compose --profile unbound up` use:
#RESOLVER_MODE=unbound
#RESOLVER_ADDRS=172.28.53.2:5353

# web | worker | all (default all). The scheduler (monitoring runs, session purge, retention)
# runs only with worker or all; with several containers give exactly the web ones ROLE=web.
#ROLE=all

# true | false (default false)
#ALLOW_SMTP_CHECKS=false
#ALLOW_REGISTRATION=false

# Public URL of this instance (http:// or https://).
#BASE_URL=http://localhost:8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL (default INFO)
#LOG_LEVEL=INFO

# Login sessions, in minutes: idle timeout (since the last request) and absolute lifetime.
# Both must be > 0 and idle <= absolute, otherwise the app refuses to start.
#SESSION_IDLE_TIMEOUT_MINUTES=30
#SESSION_ABSOLUTE_TIMEOUT_MINUTES=720

# Reverse proxies (TLS terminators) whose X-Forwarded-For header is trusted for the client IP
# used by the login and setup throttle. Comma-separated IPv4/IPv6 addresses or CIDR networks
# (10.0.0.5, 172.16.0.0/12, ::1); no hostnames, no "*". An invalid entry stops the app at
# startup. Default empty: the client IP is the direct peer and forwarding headers are ignored.
# Behind a proxy, leaving it empty makes every user share the proxy's address, so ten wrong
# passwords for an account from anyone lock that account for everyone (docs/SETUP.md section 7).
#TRUSTED_PROXIES=

# Guarded outbound HTTP client (MTA-STS, alert webhooks, ...): destination ports allowed
# (comma-separated, 1-65535, default 80,443) and redirects followed per request (0-5, default 3).
# An invalid value stops the app at startup.
#OUTBOUND_HTTP_ALLOWED_PORTS=80,443
#OUTBOUND_HTTP_MAX_REDIRECTS=3

# Monitoring history: raw check runs are pruned after this many days (1-3650, default 90);
# DNS snapshots after this many days (1-3650, default 365, never fewer than the check run days);
# an unchanged DNS snapshot is stored again after this many hours (1-720, default 24).
#CHECK_RUN_RETENTION_DAYS=90
#DNS_SNAPSHOT_RETENTION_DAYS=365
#DNS_SNAPSHOT_HEARTBEAT_HOURS=24

# Scheduler (ROLE worker or all, docs/SETUP.md section 11). Out-of-range values stop the app.
# Seconds between scheduler ticks (5-600) and due targets read per tick (1-1000).
#SCHEDULER_TICK_SECONDS=30
#SCHEDULER_BATCH_SIZE=100
# Scheduled runs at the same time (1-64) and random delay added to each next run (0-3600 s).
#SCHEDULER_MAX_CONCURRENCY=4
#SCHEDULER_JITTER_SECONDS=300
# Runs started per minute for each DNSBL list, each remote HTTP host and each tenant (1-600).
#SCHEDULER_DNSBL_RUNS_PER_MINUTE=20
#SCHEDULER_HTTP_HOST_RUNS_PER_MINUTE=10
#SCHEDULER_TENANT_RUNS_PER_MINUTE=30
# Minutes between maintenance runs: session purge and history pruning (5-1440).
#MAINTENANCE_INTERVAL_MINUTES=60
# Monitored domains (monitor targets) a tenant may have (1-1000).
#MONITOR_MAX_TARGETS_PER_TENANT=100

# Only needed with `docker compose --profile postgres up`. Choose your own value.
POSTGRES_PASSWORD=
